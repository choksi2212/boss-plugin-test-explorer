{
  "manifestVersion": 1,
  "pluginId": "ai.rever.boss.plugin.dynamic.testexplorer",
  "displayName": "Test Explorer",
  "version": "0.1.0",
  "apiVersion": "1.0.93",
  "minApiVersion": "1.0.93",
  "minBossVersion": "9.4.2",
  "mainClass": "ai.rever.boss.plugin.dynamic.testexplorer.TestExplorerDynamicPlugin",
  "type": "mixed",
  "description": "Structured JUnit XML viewer for BOSS - parses test reports and renders the result as a tree",
  "author": "choksi2212",
  "url": "https://github.com/choksi2212/boss-plugin-test-explorer",
  "panel": {
    "position": "left_bottom",
    "priority": 64
  },
  "sandbox": {
    "maxThreads": 4,
    "maxRestartAttempts": 3,
    "heartbeatIntervalMs": 5000
  },
  "isolationMode": "in-process",
  "fallback": "in-process"
}
